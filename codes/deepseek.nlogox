<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;; ============================================================================
;; Cultural Dissemination with Social Influence (Full Paper Implementation)
;; Based on: Nguyen et al., JASSS 24(4) 5, 2021
;; ============================================================================

globals [
  ;; model parameters
  F                     ;; number of cultural features
  Q                     ;; number of possible traits per feature
  grid-size             ;; width/height of square lattice
  alpha                 ;; interpolation between SIM (0) and Axelrod (1)
  include-nonoverlap?   ;; if true, use Eq.17 (non‑overlapping neighbors matter)
  periodic-boundaries?  ;; if true, wrap around edges (torus); else fixed boundaries

  ;; simulation counters
  total-events          ;; total number of agent‑neighbor selections
  total-interactions    ;; number of actual trait exchanges
  active-links          ;; number of edges with 0 < overlap < F

  ;; time tracking for plots
  event-counter         ;; used to sample at regular intervals
  sample-interval       ;; how many events between plot updates
  last-sample-events    ;; event count at last plot update
]

turtles-own [
  culture               ;; list of F integers in [0, Q-1]
  visited               ;; for region‑flooding
  neighbors-list        ;; cached list of neighboring turtles (includes self? no, just neighbors)
  my-link              ;; link set (for active‑link updates)
  region-id             ;; optional for debugging
]

;; ============================================================================
;; SETUP
;; ============================================================================

to setup
  clear-all
  set-default-shape turtles "square"
  resize-world 0 (grid-size - 1) 0 (grid-size - 1)
  ask patches [ sprout 1 [ set size 1.0 ] ]

  ;; initialize culture randomly (unless using a special config)
  ifelse initial-config = "random"
    [ initialize-culture-random ]
    [ initialize-culture-special initial-config ]

  ;; create links and cache neighbor lists
  create-links-with-neighbors
  update-active-links

  ;; counters
  set total-events 0
  set total-interactions 0
  set event-counter 0
  set last-sample-events 0
  set sample-interval 100000   ;; adjust as needed for smooth plots

  ;; plot setup
  reset-ticks
  update-plot
end

to create-links-with-neighbors
  ask turtles [
    let neighs (ifelse periodic-boundaries?
                [ periodic-neighbors self ]
                [ fixed-neighbors self ])
    set neighbors-list neighs
    foreach neighs [ other-turtle ->
      if [who] of self < [who] of other-turtle [
        create-link-with other-turtle [ set hidden? false ]
      ]
    ]
  ]
  set my-link links   ;; store for all turtles (optional)
end

to-report fixed-neighbors [t]
  report (turtles-on neighbors4)
end

to-report periodic-neighbors [t]
  let xcor [pxcor] of t
  let ycor [pycor] of t
  let offsets [[-1 0] [1 0] [0 -1] [0 1]]
  let neighbor-set []
  foreach offsets [ offset ->
    let nx (xcor + item 0 offset) mod grid-size
    let ny (ycor + item 1 offset) mod grid-size
    if nx < 0 [ set nx nx + grid-size ]
    if ny < 0 [ set ny ny + grid-size ]
    set neighbor-set lput (turtle (nx * grid-size + ny)) neighbor-set
  ]
  report turtle-sets neighbor-set
end

to initialize-culture-random
  ask turtles [
    set culture n-values F [ random Q ]
  ]
end

to initialize-culture-special [config-name]
  ;; pre‑defined configurations from the paper
  ;; you can expand these as needed
  if config-name = "Figure4" [
    ask turtles [
      let i pxcor
      let j pycor
      ;; define the matrix of 5‑digit vectors (example only; actual values from paper)
      ;; This is a placeholder – you should replace with actual data.
      set culture [14340 14340 94585 96385 02332] ;; etc.
    ]
  ]
  if config-name = "Figure5" [
    ;; similar placeholder
  ]
  ;; otherwise default random
  if config-name = "random" [ initialize-culture-random ]
end

;; ============================================================================
;; GO
;; ============================================================================

to go
  if active-links = 0 [ stop ]   ;; absorbing state reached

  ;; perform many events per tick for speed
  repeat 100000 [
    one-event
  ]

  ;; periodically update plots (every sample-interval events)
  if (total-events - last-sample-events) >= sample-interval [
    update-plot
    set last-sample-events total-events
  ]

  tick
end

to one-event
  set total-events total-events + 1

  let agent-i one-of turtles
  let neighbors-i [neighbors-list] of agent-i
  if empty? neighbors-i [ stop ]

  let agent-j one-of neighbors-i
  let overlap similarity agent-i agent-j
  let interaction-prob overlap / F

  if random-float 1 < interaction-prob [
    ;; interaction occurs
    assimilate agent-i agent-j
  ]
end

to-report similarity [a b]
  let overlap 0
  let culture-a [culture] of a
  let culture-b [culture] of b
  (foreach culture-a culture-b [ [t1 t2] -> if t1 = t2 [ set overlap overlap + 1 ] ])
  report overlap
end

to assimilate [a b]
  ;; pick a feature where they differ
  let culture-a [culture] of a
  let culture-b [culture] of b
  let possible-indices filter [ i -> item i culture-a != item i culture-b ] range F
  if empty? possible-indices [ stop ]   ;; safety
  let f one-of possible-indices

  let current-trait item f culture-a
  let neighbor-trait item f culture-b

  let cnt-current trait-support a f current-trait
  let cnt-neighbor trait-support a f neighbor-trait

  let switch-prob
    ifelse include-nonoverlap?
    [ ;; Equation 17
      let total-neighbors (count [neighbors-list] of a) + 1   ;; +1 for self
      let non-overlap total-neighbors - cnt-current - cnt-neighbor
      (cnt-neighbor + 0.5 * non-overlap) /
      (cnt-current + cnt-neighbor + 0.5 * non-overlap)
    ]
    [ ;; Equation 7
      cnt-neighbor / (cnt-current + cnt-neighbor)
    ]

  let final-prob (1 - alpha) * switch-prob + alpha
  if random-float 1 < final-prob [
    ask a [
      set culture replace-item f culture-a neighbor-trait
    ]
    set total-interactions total-interactions + 1
    update-active-links-for a
  ]
end

to-report trait-support [agent feature-index trait-value]
  let cnt 0
  ;; self
  if item feature-index ([culture] of agent) = trait-value [ set cnt cnt + 1 ]
  ;; neighbors
  foreach [neighbors-list] of agent [ n ->
    if item feature-index ([culture] of n) = trait-value [ set cnt cnt + 1 ]
  ]
  report cnt
end

;; ============================================================================
;; ACTIVE LINKS MANAGEMENT (efficient)
;; ============================================================================

to update-active-links
  set active-links count links with [
    let ov similarity end1 end2
    ov > 0 and ov < F
  ]
end

to update-active-links-for [agent]
  ask [my-link] of agent [
    let ov similarity end1 end2
    let was-active? (ov > 0 and ov < F)
    let is-active? (ov > 0 and ov < F)
    if was-active? != is-active? [
      set active-links active-links + (ifelse-value is-active? [1] [-1])
    ]
  ]
end

;; ============================================================================
;; HETEROGENEITY METRICS
;; ============================================================================

to-report rho1
  ;; average over all edges of (1 - overlap/F)
  let total 0
  let n-links count links
  if n-links = 0 [ report 0 ]
  ask links [
    let ov similarity end1 end2
    set total total + (1 - ov / F)
  ]
  report total / n-links
end

to-report rho2
  ;; configurational entropy metric (Eq.15)
  let sizes zone-size-distribution
  let m length sizes
  if m = 0 [ report 0 ]
  let sorted-sizes sort sizes   ;; ascending
  let n grid-size * grid-size
  let N-sq n
  let ln-omega 0
  let space-left n
  let i 0
  while [ i < m ] [
    let si item i sorted-sizes
    let side sqrt si
    let Ni sqrt space-left
    if Ni - side + 1 > 0 [
      set ln-omega ln-omega + ln (Ni - side + 1)
    ]
    set space-left space-left - si
    set i i + 1
  ]
  let ln-omega-max ln (factorial n)   ;; factorial approximated? we can use Stirling
  if ln-omega-max = 0 [ report 0 ]
  report (2 * ln-omega) / ln-omega-max
end

to-report factorial [x]
  if x = 0 [ report 1 ]
  report x * factorial (x - 1)
end

to-report rho3
  ;; average of (border/4*sqrt(area)) - 1
  let zones get-zones
  if length zones = 0 [ report 0 ]
  let total 0
  foreach zones [ zone ->
    let area length zone
    let border (border-count zone)
    let ideal 4 * sqrt area
    if ideal > 0 [
      set total total + (border / ideal - 1)
    ]
  ]
  report total / length zones
end

to-report border-count [turtle-setss]
  ;; count how many external agents touch the zone
  let ext-agents turtle-sets []
  ask turtle-sets [
    let neighbors (ifelse periodic-boundaries?
                   [ periodic-neighbors self ]
                   [ fixed-neighbors self ])
    set ext-agents (turtle-sets ext-agents (neighbors with [ not member? self turtle-sets ]))
  ]
  report count ext-agents
end

;; ============================================================================
;; ZONE DETECTION
;; ============================================================================

to-report zone-size-distribution
  ask turtles [ set visited false ]
  let sizes []
  let zones get-zones
  foreach zones [ z -> set sizes lput (count z) sizes ]
  report sizes
end

to-report get-zones
  ask turtles [ set visited false ]
  let zones []
  while [ any? turtles with [ not visited ] ] [
    let seed one-of turtles with [ not visited ]
    let zone grow-zone seed
    set zones lput zone zones
  ]
  report zones
end

to-report grow-zone [seed]
  let target-culture [culture] of seed
  let zone turtle-sets []
  let stack list seed
  while [ length stack > 0 ] [
    let current first stack
    set stack but-first stack
    ask current [
      if not visited [
        set visited true
        set zone (turtle-sets zone self)
        let same-neighbors (ifelse periodic-boundaries?
                            [ periodic-neighbors self ]
                            [ fixed-neighbors self ]) with [ culture = target-culture and not visited ]
        set stack sentence stack sort same-neighbors
      ]
    ]
  ]
  report zone
end

;; ============================================================================
;; PLOT UPDATES
;; ============================================================================

to update-plot
  set-current-plot "Heterogeneity"
  clear-plot
  set-current-plot "Zones"
  clear-plot

  let sizes zone-size-distribution
  let n-zones length sizes

  set-current-plot "Heterogeneity"
  set-plot-x-range 0 ticks
  plotxy ticks rho1
  plotxy ticks rho2
  plotxy ticks rho3

  set-current-plot "Zones"
  let max-size max sizes
  let total count turtles
  let largest-fraction max-size / total
  set-current-plot-pen "num-zones"
  plotxy ticks n-zones
  set-current-plot-pen "largest-zone-fraction"
  plotxy ticks largest-fraction
end

;; ============================================================================
;; INTERFACE ELEMENTS
;; ============================================================================

;; The following code defines the NetLogo interface widgets (sliders, switches, etc.)
;; These are not part of the code that is executed directly in the Procedures tab,
;; but they should be added in the Interface tab. The code below is a template
;; showing the required global variables. In the actual NetLogo model, you need
;; to create these controls manually.

;; Sliders:
;;   F (0-20) default 5
;;   Q (1-20) default 10
;;   grid-size (10-100) default 30
;;   alpha (0-1) default 0
;; Switches:
;;   include-nonoverlap? (on/off)
;;   periodic-boundaries? (on/off)
;; Chooser:
;;   initial-config (choices: random, Figure4, Figure5)
;; Monitors:
;;   total-events, total-interactions, active-links, rho1, rho2, rho3
;; Plots:
;;   "Heterogeneity" (pen rho1, rho2, rho3)
;;   "Zones" (pen num-zones, largest-zone-fraction)
;; Buttons:
;;   "setup" (calls setup)
;;   "go" (calls go, forever button)]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="434" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="434" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
  </widgets>
