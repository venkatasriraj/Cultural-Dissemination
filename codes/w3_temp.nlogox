<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [
  interaction-count
  event-count
  active-link-count
  
  prev-interaction-rate   ;; NEW
  stable-count            ;; NEW
  
  ;; ===== NEW METRICS =====
  rho1
  rho2
  rho3
]

; added on 8/4
links-own[
 is-active? 
]

turtles-own [
  culture  
  visited
  neighbors-list
  stubborn?   ;; NEW
]

to setup
  clear-all
  resize-world 0 (grid-size - 1) 0 (grid-size - 1)
  set interaction-count 0
  set event-count 0
  set prev-interaction-rate 0 ;; stubborn
  set stable-count 0 ;; stubborn
  setup-grid
  print (word "world width: " world-width " height: " world-height)
  initialize-culture
  assign-stubborn-agents   ;; NEW LINE
  create-neighbor-links

  set active-link-count 0
  ask links [
    let ov similarity end1 end2
    if (ov > 0 and ov < F) [
      set is-active? true
      set active-link-count active-link-count + 1
    ]
    if not (ov > 0 and ov < F) [
      set is-active? false
    ]
  ]
;   update-turtle-colors
  update-link-colors-simple
  reset-ticks
end

to setup-grid
  ask patches [
    sprout 1 [
      set shape "square"
      set size 0.95
      set color white
    ]
  ]
end

to initialize-culture
  ask turtles [
    set culture n-values F [ random Q ]
  ]
end

to assign-stubborn-agents ;; STUBBORN AGENTS
  ask turtles [
    if use-stubborn? [
      set stubborn? (random-float 1 < stubborn-fraction)
    ]
    if not use-stubborn? [
      set stubborn? false
    ]
  ]
end

to create-neighbor-links
  ask turtles [
    set neighbors-list shuffle sort (turtles-on neighbors4)  ;; store as list
    let me self
    foreach neighbors-list [ neighbor ->
      if [who] of me < [who] of neighbor [
        create-link-with neighbor [ set color red ]
      ]
    ]
  ]
end

to update-link-colors-simple
  ask links [
    let ov similarity end1 end2
    
    if ov = F [
      set color white   ;; same culture → same region
    ]
    
    if ov < F [
      set color black   ;; boundary / different region
    ]
    
    set thickness 0.5
  ]
end


;; --------------------   go procedure  -----------------
to go
  let should-stop? false
  let stop-reason ""

  ;; ==========================================
  ;; CHECK STOPPING CONDITIONS
  ;; ==========================================
  
  ;; Condition 1: Max Ticks
  if ticks >= max-ticks [
    set should-stop? true
    set stop-reason "Max ticks reached"
  ]

  ;; Condition 2: Epsilon Stability 
  ;; (Only check if we aren't already stopping)
  if not should-stop? [
    let current-rate interaction-rate
    if use-stubborn?[
      
      ifelse abs(current-rate - prev-interaction-rate) < epsilon [
        set stable-count stable-count + 1
      ] [
        set stable-count 0
      ]
      set prev-interaction-rate current-rate

      if stable-count > stability-window [
        set should-stop? true
        set stop-reason "Stabilized (epsilon threshold reached)"
      ]
    ]
    
  ]   

  ;; Condition 3: Absorbing State
  if not should-stop? and active-link-count = 0 [
    set should-stop? true
    set stop-reason "Absorbing state reached (active links depleted)"
  ]

  ;; ==========================================
  ;; EXECUTE FINALIZATION IF STOPPED
  ;; ==========================================
  if should-stop? [
    
;     update-borders-advanced
      
    ;; --- OPTIMIZED DATA COLLECTION ---
    let all-sizes zone-size-distribution ;; Run the heavy algorithm ONCE
    let num-regions length all-sizes
    let max-size max all-sizes
    let total-turtles count turtles
      
    ;; ===== COMPUTE METRICS =====
;     set rho1 compute-rho1
;     set rho2 compute-rho2
;     set rho3 compute-rho3
    
    update-plots ;; Triggers the 'histogram zone-size-distribution' command in the plot
      
    ;; --- PRINT REQUIRED OUTPUTS ---
    show (word "STOPPED: " stop-reason)
    show (word
      "Events: " event-count
      " | Interactions: " interaction-count
      " | Regions: " num-regions 
      " | Largest Region Fraction: " (max-size / total-turtles)
;       " | Rho1: " rho1
;       " | Rho2: " rho2
;       " | Rho3: " rho3
    )
    
    ;; Print if further interactions are possible
    ifelse active-link-count > 0 [
      show "STATUS: Further interactions ARE still possible (active links remain)."
    ] [
      show "STATUS: No further interactions are possible (0 active links)."
    ]
    
    update-turtle-colors
    update-link-colors-simple
    
    stop ;; Terminate the 'go' procedure
  ]

  ;; ==========================================
  ;; PERIODIC LOGGING (If continuing)
  ;; ==========================================
  if event-count mod 500000 = 0 and event-count > 0 [
    show (word
      "Events: " event-count
      " | Interactions: " interaction-count
      " | Interaction Rate: " interaction-rate
      " | Active Links: " active-link-count
      " | Unique Cultures: " unique-cultures )
  ]
  
  ;; ==========================================
  ;; EXECUTION (BATCHING EVENTS)
  ;; ==========================================
  let events-this-tick 0
  while [ events-this-tick < 100000 and active-link-count > 0 ] [
    one-event
    set events-this-tick events-this-tick + 1
  ]
;   one-event
  update-turtle-colors
  tick
end

to one-event
  set event-count event-count + 1 ;; included event-count i.e., choose agent + neighbor
    
  let agent-i one-of turtles
  let neighbors-i [neighbors-list] of agent-i  ;; FAST: pre-cached
  if empty? neighbors-i [ stop ] 
  
  if not empty? neighbors-i[
   let agent-j one-of neighbors-i
    
    let overlap similarity agent-i agent-j
    let interaction-prob overlap / F
    
    if random-float 1 < interaction-prob [
      assimilate agent-i agent-j ;; interaction happens
    ]
  ]
end

to-report similarity [ a b ]
  let overlap 0
  let culture-a [ culture ] of a
  let culture-b [ culture ] of b
  
  ( foreach culture-a culture-b
    [ [ trait-a trait-b] -> 
      if trait-a = trait-b [
        set overlap overlap + 1
      ]
    ])
  report overlap
end

to assimilate [a b]
  
  ;; STUBBORN RULE
  if [stubborn?] of a [ stop ]   ;; a will never change
  
  let culture-a [culture] of a
  let culture-b [culture] of b
  
  let diff-indices []

  (let i 0)
  while [i < F] [
    if item i culture-a != item i culture-b [
      set diff-indices lput i diff-indices
    ]
    set i i + 1
  ]
  
  if empty? diff-indices [ stop ]
  
  let chosen-index one-of diff-indices

  ; let support-i trait-support a chosen-index (item chosen-index culture-a) a
  
  let support-i trait-support a chosen-index (item chosen-index culture-a) 
  let support-j 0
  ifelse support-b?[    
    set support-j trait-support b chosen-index (item chosen-index culture-b) 
  ][
    set support-j trait-support a chosen-index (item chosen-index culture-b) 
  ]
  
;   let support-i trait-support a chosen-index (item chosen-index culture-a) 
;   let support-j trait-support a chosen-index (item chosen-index culture-b) 
  let switch-prob support-j / (support-i + support-j)

  if random-float 1 < ( ( 1 - alpha ) * switch-prob + alpha ) [
    ask a [ set culture replace-item chosen-index culture-a (item chosen-index culture-b) ]
    update-active-links-local a
    set interaction-count interaction-count + 1

  ]
end

to-report trait-support [agent feature-index trait-value] ;ref-agent
  let cnt 0
  if item feature-index ([culture] of agent) = trait-value [ set cnt cnt + 1 ]
  foreach (shuffle sort [neighbors-list] of agent) [ neighbor ->
    if item feature-index ([culture] of neighbor) = trait-value [ set cnt cnt + 1 ]
  ]
  report cnt
end

to-report interaction-rate
  if event-count = 0 [ report 0 ]
  report interaction-count / event-count
end

to-report unique-cultures
  report length remove-duplicates [culture] of turtles
end

to-report number-of-regions

  ask turtles [ set visited false ]
  let regions 0

  while [any? turtles with [not visited]] [
    let seed one-of turtles with [not visited]
    set regions regions + 1
    grow-region seed
  ]
  report regions
end

to grow-region [seed]

  let target [culture] of seed
  let frontier (list seed)

  while [length frontier > 0] [
    let current first frontier
    set frontier but-first frontier
    ask current [
      if not visited [
        set visited true
        let same-neighbors (turtles-on neighbors4) with [
          culture = target and not visited
        ]
        set frontier sentence frontier sort same-neighbors
      ]
    ]
  ]
end

to-report culture-color [culture-list]

  let hash 0
  foreach culture-list [ t ->
    set hash (hash * 7 + t)
  ]
  report (hash mod 140)
end

to update-turtle-colors
  ask turtles [    
    set color culture-color culture
    if stubborn? [
      ;;set color red
      set size 1.15
      set shape "circle"
    ]
    if not stubborn? [
      
      set size 0.95
      set shape "square"
    ]
  ]
end

to update-active-links-local [a]

  ;; update links of a
  ask [my-links] of a [
    update-link-state self
  ]
end

to update-link-state [lnk]

  ask lnk [
    let was-active is-active?
    let ov similarity end1 end2
    let now-active (ov > 0 and ov < F)

    ;; update count
    if (was-active and not now-active) [
      set active-link-count max list 0 (active-link-count - 1)
    ]
    if (not was-active and now-active) [
      set active-link-count active-link-count + 1
    ]

    set is-active? now-active

    ;; visual (optional)
    if ov = F [ set color white ]
    if ov = 0 [ set color black ]
    if ov > 0 and ov < F [ set color green ]
  ]

end



;;  ---------------  find the size of largets region ---------------
to-report grow-region-size [seed]

  let target [culture] of seed
  let frontier (list seed)
  let total-size 0

  while [length frontier > 0] [
    let current first frontier
    set frontier but-first frontier

    ask current [
      if not visited [
        set visited true
        set total-size total-size + 1   ;; 🔥 COUNT HERE

        let same-neighbors (turtles-on neighbors4) with [
          culture = target and not visited
        ]
        set frontier sentence frontier sort same-neighbors
      ]
    ]
  ]

  report total-size
end

to-report largest-region-size

  ask turtles [ set visited false ]
  let max-size 0

  while [any? turtles with [not visited]] [
    let seed one-of turtles with [not visited]
    let total-size grow-region-size seed

    if total-size > max-size [
      set max-size total-size
    ]
  ]

  report max-size
end

to-report largest-region-fraction
  report largest-region-size / count turtles
end

to-report zone-size-distribution

  ask turtles [ set visited false ]
  let sizes []

  while [any? turtles with [not visited]] [
    let seed one-of turtles with [not visited]
    let s grow-region-size seed
    set sizes lput s sizes
  ]

  report sizes
end
to-report zone-size-histogram
  let sizes zone-size-distribution
  let unique-sizes remove-duplicates sizes
  
  ;; This does the exact same thing as your loop in one line
  report map [ s -> list s (length filter [x -> x = s] sizes) ] unique-sizes
end



;;    -------------------   Start Phase 3   -----------------------

to-report run-model
  setup
  
  while [active-link-count > 0] [
    one-event
  ]

  report (list
    event-count
    interaction-count
    interaction-rate
    number-of-regions
    unique-cultures
    largest-region-fraction  
  )

end

to-report run-experiments [runs]
  let results []

  repeat runs [
    set results lput (run-model) results
  ]
  report results
end

to-report average [lst]
  report mean lst
end

to-report summarize-results [results]

  let events map [r -> item 0 r] results
  let interactions map [r -> item 1 r] results
  let rates map [r -> item 2 r] results
  let regions map [r -> item 3 r] results
  let cultures map [r -> item 4 r] results
  let largest map [r -> item 5 r] results 
  report (list
    average events
    average interactions
    average rates
    average regions
    average cultures
    average largest)
end

to-report absorbing?
  report active-links = 0
end

;; ------------------------------   METRICS  ------------------------------

to-report compute-rho1
  let total-dissimilarity 0
  let total-links 0

  ask turtles [
    let my-culture culture
    foreach neighbors-list [ nbr ->
      let overlap similarity self nbr
      set total-dissimilarity total-dissimilarity + (1 - overlap / F)
      set total-links total-links + 1
    ]
  ]

  if total-links = 0 [ report 0 ]
  report total-dissimilarity / total-links
end

to-report compute-rho2
  let sizes zone-size-distribution
  let sizes-sorted sort sizes

  let N world-width
  let Ni N
  let entropy 0

  foreach sizes-sorted [
    s ->
    let term (Ni - sqrt s + 1)
    if term > 0 [
      set entropy entropy + ln term
    ]
    set Ni sqrt (Ni * Ni - s)
  ]

  ;; Stirling approximation (IMPORTANT)
  let total count turtles
  let max-entropy (total * ln total - total)

  if max-entropy = 0 [ report 0 ]
  report entropy / max-entropy
end

to-report compute-rho3
  ask turtles [ set visited false ]
  
  let sizes []
  let boundaries []
  
  while [any? turtles with [not visited]] [
    let seed one-of turtles with [not visited]
    let zone (get-zone seed)
    
    let S length zone
    let B 0
    
    foreach zone [ t ->
      ask t [
        foreach neighbors-list [ nbr ->
          if not member? nbr zone [
            set B B + 1
          ]
        ]
      ]
    ]
    
    set sizes lput S sizes
    set boundaries lput B boundaries
  ]

  let M length sizes
  if M = 0 [ report 0 ]

  let total 0
  (foreach sizes boundaries [
    [s b] ->
    let denom (4 * sqrt s)
    if denom > 0 [
      set total total + (b / denom)
    ]
  ])

  report (total / M) - 1
end

to-report get-zone [seed]
  let target [culture] of seed
  let frontier (list seed)
  let zone []

  while [length frontier > 0] [
    let current first frontier
    set frontier but-first frontier

    if not member? current zone [
      set zone lput current zone

      ask current [
        let same-neighbors (turtles-on neighbors4) with [
          culture = target
        ]
        set frontier sentence frontier sort same-neighbors
      ]
    ]
  ]

  report zone
end




;   --------------------------------      Not in use     -----------------------------
to-report interaction-possible?
  let result false

  ask turtles [
    ask turtles-on neighbors4 [          ;; self = neighbor turtle
      let overlap similarity myself self  ;; myself = outer turtle, self = neighbor
      if overlap > 0 and overlap < F [
        set result true
      ]
    ]
  ]
  report result
end

to-report active-links
  let count1 0

  ask turtles [
    ask turtles-on neighbors4 [
      let overlap similarity myself self
      if overlap > 0 and overlap < F [
        set count1 count1 + 1
      ]
    ]
  ]
  report count1 / 2
end

to flood-fill [start-turtle]
  let target-culture [culture] of start-turtle
  let stack (list start-turtle)

  while [length stack > 0] [
    let current first stack
    set stack but-first stack
    
    ask current [
      if not visited [
        set visited true

        let neighbors-with-same-culture
          (turtles-on neighbors4) with [culture = target-culture]  ;; fix: parentheses
        set stack sentence stack sort neighbors-with-same-culture  ;; sort to convert agentset to list
      ]
    ]
  ]
end

to update-borders-advanced
  ask links [
    set hidden? false
    let s similarity end1 end2   ; assume s is between 0 and 1
    let interaction-prob s / F
    let grey-level 9.9 * (1 - interaction-prob)  ; 0 = black, 9.9 = white
    set color grey-level
    set thickness 1
  ]
end]]></code>
